@model List<OtobusFinalProje.Models.Seferler>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Seferler</h2>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<a href="/Admin/Sefer/Ekle" class="btn btn-primary mb-3">+ Yeni Sefer</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Firma</th>
            <th>Otobüs</th>
            <th>Rota</th>
            <th>Kalkış</th>
            <th>Varış</th>
            <th>Fiyat</th>
            <th>Durum</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Firma?.FirmaAdi</td>
                    <td>@item.Otobus?.Plaka</td>
                    <td>@item.Rota?.NeredenSehir?.SehirAdi → @item.Rota?.NereyeSehir?.SehirAdi</td>
                    <td>@item.KalkisTarihiSaat.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.VarisTarihiSaat.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.Fiyat.ToString("N2") ₺</td>
                    <td>@(item.AktifMi ? "Aktif" : "Pasif")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">Henüz sefer yok.</td>
            </tr>
        }
    </tbody>
</table>