@model List<OtobusFinalProje.Models.Sehirler>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-3">Şehirler</h2>

<!-- ===================== EKLE FORMU ===================== -->
<div class="card p-3 mb-4">
    <form method="post" asp-action="Ekle">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Şehir Adı</label>
            <input name="sehirAdi" class="form-control" placeholder="Şehir adı giriniz" />
        </div>

        <button type="submit" class="btn btn-success mt-2">
            Ekle
        </button>
    </form>
</div>

<!-- ===================== MESAJLAR ===================== -->
@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">
        @TempData["Basari"]
    </div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">
        @TempData["Hata"]
    </div>
}

<!-- ===================== TABLO ===================== -->
<div class="card p-3">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Şehir Adı</th>
                <th>Durum</th>
                <th style="width: 200px;">İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SehirAdi</td>

                    <td>
                        @if (item.AktifMi)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>

                    <td>
                        <!-- Düzenle -->
                        <a asp-action="Duzenle"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">
                            Düzenle
                        </a>

                        <!-- Sil (Soft delete) -->
                        <form asp-action="Sil"
                              asp-route-id="@item.Id"
                              method="post"
                              style="display:inline-block">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Silmek istediğine emin misin?')">
                                Sil
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>