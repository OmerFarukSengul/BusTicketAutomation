<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        .sidebar {
            width: 270px;
            min-height: 100vh;
            background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
            color: white;
            position: fixed;
            left: 0;
            top: 0;
            padding: 25px 18px;
            box-shadow: 4px 0 25px rgba(0,0,0,0.15);
            z-index: 1000;
        }

        .logo {
            font-size: 1.6rem;
            font-weight: bold;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .logo i {
                color: #60a5fa;
            }

        .menu-title {
            font-size: 12px;
            color: #94a3b8;
            text-transform: uppercase;
            margin-top: 20px;
            margin-bottom: 12px;
            letter-spacing: 1px;
        }

        .nav-link {
            color: #e2e8f0 !important;
            border-radius: 14px;
            margin-bottom: 8px;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: 0.3s;
            font-weight: 500;
        }

            .nav-link i {
                font-size: 18px;
            }

            .nav-link:hover {
                background: rgba(255,255,255,0.08);
                transform: translateX(4px);
                color: white !important;
            }

            .nav-link.active-menu {
                background: linear-gradient(135deg, #2563eb, #3b82f6);
                box-shadow: 0 5px 15px rgba(59,130,246,0.35);
            }

        .main-content {
            margin-left: 270px;
            min-height: 100vh;
            padding: 30px;
        }

        .topbar {
            background: white;
            padding: 18px 25px;
            border-radius: 22px;
            box-shadow: 0 8px 25px rgba(15,23,42,0.06);
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .topbar h3 {
                margin: 0;
                font-weight: 700;
                color: #0f172a;
            }

        .admin-badge {
            background: #eff6ff;
            color: #2563eb;
            padding: 10px 18px;
            border-radius: 14px;
            font-weight: 600;
        }

        .content-card {
            background: white;
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 10px 35px rgba(15,23,42,0.06);
        }

        .footer-text {
            margin-top: 25px;
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        media(max - width: 992px)

        {
            .sidebar

        {
            width: 100%;
            min-height: auto;
            position: relative;
        }

        .main-content {
            margin-left: 0;
            padding: 20px;
        }

        .topbar {
            flex-direction: column;
            gap: 10px;
            align-items: flex-start;
        }

        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="logo">
            <i class="bi bi-shield-lock-fill"></i>
            Admin Panel
        </div>

        <div class="menu-title">
            Yönetim
        </div>

        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.Value.Contains("/Admin/Sehir") ? "active-menu" : "")"
                   href="/Admin/Sehir">

                    <i class="bi bi-geo-alt-fill"></i>
                    Şehirler
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.Value.Contains("/Admin/Firma") ? "active-menu" : "")"
                   href="/Admin/Firma">

                    <i class="bi bi-building"></i>
                    Firmalar
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.Value.Contains("/Admin/Otobus") ? "active-menu" : "")"
                   href="/Admin/Otobus">

                    <i class="bi bi-bus-front-fill"></i>
                    Otobüsler
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.Value.Contains("/Admin/Rota") ? "active-menu" : "")"
                   href="/Admin/Rota">

                    <i class="bi bi-sign-turn-right-fill"></i>
                    Rotalar
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(Context.Request.Path.Value.Contains("/Admin/Sefer") ? "active-menu" : "")"
                   href="/Admin/Sefer">

                    <i class="bi bi-calendar-event-fill"></i>
                    Seferler
                </a>
            </li>

        </ul>

        <div class="menu-title mt-4">
            Sistem
        </div>

        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link" href="/">

                    <i class="bi bi-house-door-fill"></i>
                    Siteye Dön
                </a>
            </li>

        </ul>

    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">

        <!-- TOPBAR -->
        <div class="topbar">

            <div>
                <h3>Otobüs Bilet Yönetim Sistemi</h3>
            </div>

            

        </div>

        <!-- CONTENT -->
        <div class="content-card">

            @RenderBody()

        </div>

        <div class="footer-text">
            © @DateTime.Now.Year Admin Yönetim Paneli
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>