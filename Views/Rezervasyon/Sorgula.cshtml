@{
    ViewData["Title"] = "PNR Sorgula";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2>PNR Sorgula</h2>
        <p class="text-muted">Bilet detaylarını görmek için PNR numaranı gir.</p>

        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger">@TempData["Hata"]</div>
        }

        <form asp-controller="Rezervasyon" asp-action="Sorgula" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label>PNR No</label>
                <input name="pnrNo" class="form-control" placeholder="Örn: A1B2C3D4" />
            </div>

            <button class="btn btn-primary">Sorgula</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ana Sayfa</a>
        </form>
    </div>
</div>